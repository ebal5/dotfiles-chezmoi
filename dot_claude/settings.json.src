{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "advisorModel": "opus",
  "agentPushNotifEnabled": true,
  "alwaysThinkingEnabled": true,
  "effortLevel": "medium",
  "enabledPlugins": {},
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
  "hooks": {
    "SessionEnd": [
      {
        "hooks": [
          {
            "command": "~/.scripts/tmux_claude_title.sh session-end",
            "type": "command"
          }
        ],
        "matcher": ""
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "~/.scripts/tmux_claude_title.sh session-start",
            "type": "command"
          },
          {
            "command": "~/.scripts/herdr_agent_state.sh session",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": ""
      }
    ]
  },
  "outputStyle": "Concise",
  "permissions": {
    "allow": [
      "Bash(docker compose logs *)",
      "Bash(docker compose ps *)",
      "Bash(docker compose up *)",
      "Bash(docker image ls *)",
      "Bash(docker images *)",
      "Bash(docker inspect *)",
      "Bash(docker logs *)",
      "Bash(docker ps *)",
      "Bash(gh cache list *)",
      "Bash(gh gist list *)",
      "Bash(gh gist view *)",
      "Bash(gh issue list *)",
      "Bash(gh issue view *)",
      "Bash(gh pr checks *)",
      "Bash(gh pr diff *)",
      "Bash(gh pr list *)",
      "Bash(gh pr status)",
      "Bash(gh pr view *)",
      "Bash(gh release list *)",
      "Bash(gh release view *)",
      "Bash(gh repo list *)",
      "Bash(gh repo view *)",
      "Bash(gh run list *)",
      "Bash(gh run view *)",
      "Bash(gh run watch *)",
      "Bash(gh search *)",
      "Bash(gh status)",
      "Bash(gh variable list *)",
      "Bash(gh workflow list *)",
      "Bash(gh workflow view *)",
      "Bash(jq *)",
      "Bash(git add *)",
      "Bash(git branch *)",
      "Bash(git check-ignore *)",
      "Bash(git checkout *)",
      "Bash(git commit *)",
      "Bash(git fetch *)",
      "Bash(git merge --ff-only *)",
      "Bash(git merge-base *)",
      "Bash(git rebase *)",
      "Bash(git stash *)",
      "Bash(git switch *)",
      "Bash(git worktree list *)",
      "Bash(git worktree remove *)",
      "Bash(chmod +x *)",
      "Bash(mkdir *)",
      "Bash(rg *)",
      "Skill",
      "WebFetch(domain:docs.anthropic.com)",
      "WebSearch",
      "Bash(git worktree add *)",
      "Bash(git mv *)",
      "Bash(git grep *)",
      "Bash(pgrep *)",
      "Bash(shfmt *)",
      "Bash(shellcheck *)",
      "Bash(markdownlint-cli2 *)",
      "Bash(prek run *)",
      "Bash(aws * describe-*)",
      "Bash(aws * list-*)",
      "Bash(aws s3 ls *)",
      "Bash(aws sts get-caller-identity *)",
      "Bash(aws logs get-log-events *)",
      "Bash(aws logs filter-log-events *)",
      "Bash(aws logs tail *)"
    ],
    "ask": [
      "Bash(docker system prune *)",
      "Bash(docker volume rm *)",
      "Bash(gh api *)",
      "Bash(gh label create *)",
      "Bash(git push *main)",
      "Bash(git push * main *)",
      "Bash(git push *:main *)",
      "Bash(git -C * push *main)",
      "Bash(git -C * push * main *)",
      "Bash(git -C * push *:main *)",
      "Bash(rm -rf *)",
      "Bash(git reset --hard *)",
      "Bash(git clean -f *)",
      "Bash(git clean -fd *)",
      "Bash(chezmoi apply *)",
      "Bash(sudo *)",
      "Bash(git rebase *--ex*)",
      "Bash(git rebase -x*)",
      "Bash(git rebase * -x*)",
      "Bash(git worktree remove *--f*)",
      "Bash(git worktree remove -f *)",
      "Bash(git worktree remove * -f*)",
      "Bash(git stash drop *)",
      "Bash(git stash clear *)",
      "Bash(aws * create-*)",
      "Bash(aws * delete-*)",
      "Bash(aws * put-*)",
      "Bash(aws * update-*)",
      "Bash(aws * terminate-*)",
      "Bash(aws s3 cp *)",
      "Bash(aws s3 mv *)",
      "Bash(aws s3 rm *)",
      "Bash(aws s3 sync *)",
      "Bash(aws s3 rb *)",
      "Bash(aws lambda invoke *)"
    ],
    "deny": [
      "Bash(git push *--force*)",
      "Bash(git push -f *)",
      "Bash(git push * -f*)",
      "Bash(git push * +*)",
      "Bash(git -C * push *--force*)",
      "Bash(git -C * push -f*)",
      "Bash(git -C * push * -f*)",
      "Bash(git -C * push * +*)",
      "Bash(chmod 777 *)",
      "Bash(chmod -R 777 *)",
      "Bash(dd *)",
      "Bash(curl * | bash *)",
      "Bash(curl * | sh *)",
      "Bash(wget * | bash *)",
      "Bash(wget * | sh *)",
      "Bash(chezmoi destroy *)"
    ]
  },
  "statusLine": {
    "command": "~/.scripts/claude_statusline.sh",
    "type": "command"
  },
  "teammateMode": "auto",
  "tui": "fullscreen",
  "worktree": {
    "symlinkDirectories": [
      "docs.local"
    ]
  }
}
