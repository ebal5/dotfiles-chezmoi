{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "advisorModel": "opus",
  "agentPushNotifEnabled": true,
  "alwaysThinkingEnabled": true,
  "effortLevel": "high",
  "enabledPlugins": {},
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
  "hooks": {
    "SessionEnd": [
      {
        "hooks": [
          {
            "command": "~/.scripts/tmux_claude_title.sh session-end",
            "type": "command"
          }
        ],
        "matcher": ""
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "~/.scripts/tmux_claude_title.sh session-start",
            "type": "command"
          },
          {
            "command": "~/.scripts/herdr_agent_state.sh session",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": ""
      }
    ]
  },
  "outputStyle": "Concise",
  "permissions": {
    "allow": [
      "Bash(docker compose logs *)",
      "Bash(docker compose ps *)",
      "Bash(docker compose up *)",
      "Bash(docker image ls *)",
      "Bash(docker images *)",
      "Bash(docker inspect *)",
      "Bash(docker logs *)",
      "Bash(docker ps *)",
      "Bash(gh cache list *)",
      "Bash(gh gist list *)",
      "Bash(gh gist view *)",
      "Bash(gh issue list *)",
      "Bash(gh issue view *)",
      "Bash(gh pr checks *)",
      "Bash(gh pr diff *)",
      "Bash(gh pr list *)",
      "Bash(gh pr status)",
      "Bash(gh pr view *)",
      "Bash(gh release list *)",
      "Bash(gh release view *)",
      "Bash(gh repo list *)",
      "Bash(gh repo view *)",
      "Bash(gh run list *)",
      "Bash(gh run view *)",
      "Bash(gh run watch *)",
      "Bash(gh search *)",
      "Bash(gh status)",
      "Bash(gh variable list *)",
      "Bash(gh workflow list *)",
      "Bash(gh workflow view *)",
      "Bash(jq *)",
      "Bash(git add *)",
      "Bash(git branch *)",
      "Bash(git check-ignore *)",
      "Bash(git checkout *)",
      "Bash(git commit *)",
      "Bash(git fetch *)",
      "Bash(git merge-base *)",
      "Bash(git stash *)",
      "Bash(git switch *)",
      "Bash(mkdir -p *)",
      "Bash(mkdir *)",
      "Bash(rg *)",
      "Skill",
      "WebFetch(domain:docs.anthropic.com)",
      "WebSearch"
    ],
    "ask": [
      "Bash(docker compose down *)",
      "Bash(docker compose restart *)",
      "Bash(docker compose rm *)",
      "Bash(docker system prune *)",
      "Bash(docker volume rm *)",
      "Bash(gh api *)",
      "Bash(gh issue create *)",
      "Bash(gh issue edit *)",
      "Bash(gh label create *)",
      "Bash(gh pr create *)",
      "Bash(git merge *)",
      "Bash(git push *)",
      "Bash(git rebase *)",
      "Bash(git stash drop *)",
      "Bash(git stash clear)",
      "Bash(git tag *)",
      "Bash(git cherry-pick *)",
      "Bash(aws *)",
      "Bash(chmod +x *)",
      "Bash(chezmoi apply *)",
      "Bash(sudo *)"
    ],
    "deny": [
      "Bash(rm -rf *)",
      "Bash(git reset --hard *)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git push origin --force *)",
      "Bash(git push origin -f *)",
      "Bash(git clean -f *)",
      "Bash(git clean -fd *)",
      "Bash(git branch -D *)",
      "Bash(chmod 777 *)",
      "Bash(chmod -R 777 *)",
      "Bash(dd *)",
      "Bash(curl * | bash *)",
      "Bash(curl * | sh *)",
      "Bash(wget * | bash *)",
      "Bash(wget * | sh *)",
      "Bash(chezmoi destroy *)"
    ]
  },
  "statusLine": {
    "command": "~/.scripts/claude_statusline.sh",
    "type": "command"
  },
  "teammateMode": "auto",
  "tui": "fullscreen"
}
